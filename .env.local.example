# Password Protection
# Set this in Vercel Environment Variables
NEXT_PUBLIC_SITE_PASSWORD=your-password-here

# To disable password protection, comment out or remove the variable
# NEXT_PUBLIC_SITE_PASSWORD=

# Google Analytics
# Get your Measurement ID from: https://analytics.google.com/
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Supabase
# Get these from your Supabase project: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
